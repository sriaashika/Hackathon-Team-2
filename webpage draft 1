<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartBasket | Shop Smarter</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="top-header">

        <div class="logo">
            Smart<span>Basket</span>
        </div>

        <div class="location">
            <small>Deliver to</small>
            <strong>📍 Hyderabad</strong>
        </div>

        <div class="search-container">

            <select id="categorySelect">
                <option>All</option>
                <option>Travel</option>
                <option>College</option>
                <option>Electronics</option>
                <option>Home</option>
                <option>Fashion</option>
            </select>

            <input
                type="text"
                id="searchInput"
                placeholder="Search for products, brands and more..."
            >

            <button id="searchButton">
                🔍
            </button>

        </div>

        <div class="header-actions">

            <div class="account">
                <small>Hello, Sign in</small>
                <strong>Account & Lists ▾</strong>
            </div>

            <div class="orders">
                <small>Returns</small>
                <strong>& Orders</strong>
            </div>

            <button class="cart-button" onclick="openCart()">
                🛒
                <span id="cartCount">0</span>
            </button>

        </div>

    </header>


    <!-- ================= SECOND NAV ================= -->

    <nav class="sub-nav">

        <div class="menu">
            ☰ <strong>All</strong>
        </div>

        <a href="#deals">Today's Deals</a>
        <a href="#categories">Categories</a>
        <a href="#smartbasket">SmartBasket Builder</a>
        <a href="#products">Best Sellers</a>
        <a href="#baskets">Ready Baskets</a>

        <div class="nav-offer">
            ⚡ Smart Deals
        </div>

    </nav>


    <!-- ================= HERO ================= -->

    <section class="hero">

        <div class="hero-content">

            <div class="hero-tag">
                ✨ A smarter way to shop
            </div>

            <h1>
                Don't just buy.
                <span>Build your basket.</span>
            </h1>

            <p>
                Tell SmartBasket what you're preparing for,
                your budget and what matters most.
                We'll help you create the right basket.
            </p>

            <div class="hero-buttons">

                <button
                    class="primary-button"
                    onclick="scrollToSection('smartbasket')">
                    Build My Basket →
                </button>

                <button
                    class="outline-button"
                    onclick="scrollToSection('products')">
                    Explore Products
                </button>

            </div>

            <div class="hero-trust">

                <div>
                    <strong>10K+</strong>
                    <span>Products</span>
                </div>

                <div>
                    <strong>50+</strong>
                    <span>Smart Baskets</span>
                </div>

                <div>
                    <strong>₹0</strong>
                    <span>Planning Fee</span>
                </div>

            </div>

        </div>


        <!-- HERO PRODUCT DISPLAY -->

        <div class="hero-shopping-card">

            <div class="floating-offer">
                🔥 Trending
            </div>

            <div class="hero-image">

                <img
                    src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=900&q=85"
                    alt="Premium backpack"
                >

            </div>

            <div class="hero-product-info">

                <div>
                    <h3>Urban Travel Backpack</h3>
                    <p>Perfect for college, travel & everyday use</p>
                </div>

                <div class="hero-price">
                    ₹899
                </div>

            </div>

            <div class="hero-rating">
                ⭐ 4.6 &nbsp; <span>2,341 ratings</span>
            </div>

            <button onclick="addToCart('Urban Travel Backpack',899)">
                + Add to Basket
            </button>

        </div>

    </section>


    <!-- ================= OFFER STRIP ================= -->

    <section class="offer-strip" id="deals">

        <div class="offer-item">
            🚚
            <div>
                <strong>Free Delivery</strong>
                <small>On selected products</small>
            </div>
        </div>

        <div class="offer-item">
            💳
            <div>
                <strong>Easy Payments</strong>
                <small>Multiple payment options</small>
            </div>
        </div>

        <div class="offer-item">
            🎯
            <div>
                <strong>Smart Recommendations</strong>
                <small>Products based on your needs</small>
            </div>
        </div>

        <div class="offer-item">
            🔒
            <div>
                <strong>Secure Shopping</strong>
                <small>Your data stays protected</small>
            </div>
        </div>

    </section>


    <!-- ================= CATEGORIES ================= -->

    <section class="section" id="categories">

        <div class="section-header">

            <div>
                <span class="section-label">SHOP BY NEED</span>

                <h2>
                    What are you preparing for?
                </h2>
            </div>

            <a href="#smartbasket">
                View all →
            </a>

        </div>


        <div class="category-grid">

            <div class="category-card travel"
                 onclick="selectSituation('travel')">

                <div class="category-content">
                    <span>✈️</span>

                    <h3>Travel</h3>

                    <p>
                        Bags, bottles, organizers & more
                    </p>

                    <strong>Shop now →</strong>
                </div>

                <img
                    src="https://images.unsplash.com/photo-1553531384-cc64ac80f931?auto=format&fit=crop&w=600&q=80"
                    alt="Travel"
                >

            </div>


            <div class="category-card college"
                 onclick="selectSituation('college')">

                <div class="category-content">
                    <span>🎓</span>

                    <h3>College & Hostel</h3>

                    <p>
                        Everything for your new campus life
                    </p>

                    <strong>Shop now →</strong>
                </div>

                <img
                    src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=600&q=80"
                    alt="College"
                >

            </div>


            <div class="category-card home"
                 onclick="selectSituation('home')">

                <div class="category-content">
                    <span>🏠</span>

                    <h3>New Home</h3>

                    <p>
                        Set up your space without the stress
                    </p>

                    <strong>Shop now →</strong>
                </div>

                <img
                    src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=600&q=80"
                    alt="Home"
                >

            </div>


            <div class="category-card workspace"
                 onclick="selectSituation('workspace')">

                <div class="category-content">
                    <span>💻</span>

                    <h3>Workspace</h3>

                    <p>
                        Build a productive study setup
                    </p>

                    <strong>Shop now →</strong>
                </div>

                <img
                    src="https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=600&q=80"
                    alt="Workspace"
                >

            </div>

        </div>

    </section>


    <!-- ================= SMART BASKET ================= -->

    <section class="smart-builder" id="smartbasket">

        <div class="builder-intro">

            <span class="section-label light">
                SMARTBASKET BUILDER
            </span>

            <h2>
                Tell us your situation.
                <br>
                We'll handle the shopping list.
            </h2>

            <p>
                Choose what you're preparing for,
                set your budget and we'll recommend
                products that fit together.
            </p>

            <div class="builder-benefits">

                <div>
                    <span>01</span>
                    <strong>Choose your situation</strong>
                </div>

                <div>
                    <span>02</span>
                    <strong>Set your budget</strong>
                </div>

                <div>
                    <span>03</span>
                    <strong>Build your basket</strong>
                </div>

            </div>

        </div>


        <div class="builder-box">

            <div class="builder-top">

                <div>
                    <small>YOUR SMART BASKET</small>

                    <h3 id="basketTitle">
                        🎓 College Starter Basket
                    </h3>
                </div>

                <div class="budget-display">
                    Budget
                    <strong id="budgetValue">
                        ₹5,000
                    </strong>
                </div>

            </div>


            <label>
                What are you preparing for?
            </label>

            <div class="situation-buttons">

                <button
                    class="situation-btn active"
                    onclick="selectSituation('college')">
                    🎓 College
                </button>

                <button
                    class="situation-btn"
                    onclick="selectSituation('travel')">
                    ✈️ Travel
                </button>

                <button
                    class="situation-btn"
                    onclick="selectSituation('home')">
                    🏠 Home
                </button>

                <button
                    class="situation-btn"
                    onclick="selectSituation('workspace')">
                    💻 Workspace
                </button>

            </div>


            <label>
                Your budget
            </label>

            <div class="budget-input">

                <span>₹</span>

                <input
                    type="number"
                    id="budgetInput"
                    value="5000"
                    min="500"
                    oninput="updateBudget()"
                >

            </div>


            <div class="recommended-items">

                <div class="basket-item">

                    <img
                        src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=300&q=80"
                        alt="Backpack"
                    >

                    <div>
                        <strong>College Backpack</strong>
                        <small>Essential</small>
                    </div>

                    <b>₹899</b>

                </div>


                <div class="basket-item">

                    <img
                        src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=300&q=80"
                        alt="Water bottle"
                    >

                    <div>
                        <strong>Insulated Bottle</strong>
                        <small>Essential</small>
                    </div>

                    <b>₹499</b>

                </div>


                <div class="basket-item">

                    <img
                        src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=300&q=80"
                        alt="Desk lamp"
                    >

                    <div>
                        <strong>Study Lamp</strong>
                        <small>Useful</small>
                    </div>

                    <b>₹599</b>

                </div>

            </div>


            <div class="builder-total">

                <div>
                    <small>Estimated basket value</small>
                    <strong id="basketTotal">
                        ₹1,997
                    </strong>
                </div>

                <button onclick="createBasket()">
                    Create My Basket →
                </button>

            </div>

        </div>

    </section>


    <!-- ================= PRODUCTS ================= -->

    <section class="section" id="products">

        <div class="section-header">

            <div>

                <span class="section-label">
                    TRENDING NOW
                </span>

                <h2>
                    Popular products
                </h2>

            </div>

            <a href="#">
                See all products →
            </a>

        </div>


        <div class="product-grid" id="productGrid">


            <!-- PRODUCT 1 -->

            <div class="product-card"
                 data-name="backpack travel bag">

                <div class="product-image">

                    <span class="discount">
                        28% OFF
                    </span>

                    <button class="wishlist">
                        ♡
                    </button>

                    <img
                        src="https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=700&q=85"
                        alt="Travel backpack"
                    >

                </div>

                <div class="product-details">

                    <span class="product-category">
                        TRAVEL
                    </span>

                    <h3>
                        Urban Travel Backpack
                    </h3>

                    <div class="rating">
                        ⭐ 4.6
                        <span>(2,341)</span>
                    </div>

                    <div class="price-row">

                        <strong>
                            ₹899
                        </strong>

                        <del>
                            ₹1,249
                        </del>

                    </div>

                    <small class="delivery">
                        FREE delivery tomorrow
                    </small>

                    <button
                        class="add-cart"
                        onclick="addToCart('Urban Travel Backpack',899)">
                        Add to Basket
                    </button>

                </div>

            </div>


            <!-- PRODUCT 2 -->

            <div class="product-card"
                 data-name="water bottle insulated bottle">

                <div class="product-image">

                    <span class="discount">
                        22% OFF
                    </span>

                    <button class="wishlist">
                        ♡
                    </button>

                    <img
                        src="https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=700&q=85"
                        alt="Insulated water bottle"
                    >

                </div>

                <div class="product-details">

                    <span class="product-category">
                        DAILY ESSENTIALS
                    </span>

                    <h3>
                        Stainless Steel Bottle
                    </h3>

                    <div class="rating">
                        ⭐ 4.7
                        <span>(5,921)</span>
                    </div>

                    <div class="price-row">

                        <strong>
                            ₹499
                        </strong>

                        <del>
                            ₹639
                        </del>

                    </div>

                    <small class="delivery">
                        FREE delivery tomorrow
                    </small>

                    <button
                        class="add-cart"
                        onclick="addToCart('Stainless Steel Bottle',499)">
                        Add to Basket
                    </button>

                </div>

            </div>


            <!-- PRODUCT 3 -->

            <div class="product-card"
                 data-name="desk lamp study lamp">

                <div class="product-image">

                    <span class="discount">
                        35% OFF
                    </span>

                    <button class="wishlist">
                        ♡
                    </button>

                    <img
                        src="https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=700&q=85"
                        alt="Desk lamp"
                    >

                </div>

                <div class="product-details">

                    <span class="product-category">
                        WORKSPACE
                    </span>

                    <h3>
                        Minimal LED Study Lamp
                    </h3>

                    <div class="rating">
                        ⭐ 4.5
                        <span>(1,874)</span>
                    </div>

                    <div class="price-row">

                        <strong>
                            ₹599
                        </strong>

                        <del>
                            ₹919
                        </del>

                    </div>

                    <small class="delivery">
                        FREE delivery tomorrow
                    </small>

                    <button
                        class="add-cart"
                        onclick="addToCart('Minimal LED Study Lamp',599)">
                        Add to Basket
                    </button>

                </div>

            </div>


            <!-- PRODUCT 4 -->

            <div class="product-card"
                 data-name="headphones wireless electronics">

                <div class="product-image">

                    <span class="discount">
                        31% OFF
                    </span>

                    <button class="wishlist">
                        ♡
                    </button>

                    <img
                        src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=700&q=85"
                        alt="Wireless headphones"
                    >

                </div>

                <div class="product-details">

                    <span class="product-category">
                        ELECTRONICS
                    </span>

                    <h3>
                        Wireless Headphones
                    </h3>

                    <div class="rating">
                        ⭐ 4.4
                        <span>(3,412)</span>
                    </div>

                    <div class="price-row">

                        <strong>
                            ₹1,299
                        </strong>

                        <del>
                            ₹1,899
                        </del>

                    </div>

                    <small class="delivery">
                        FREE delivery tomorrow
                    </small>

                    <button
                        class="add-cart"
                        onclick="addToCart('Wireless Headphones',1299)">
                        Add to Basket
                    </button>

                </div>

            </div>


        </div>

    </section>


    <!-- ================= READY BASKETS ================= -->

    <section class="basket-section" id="baskets">

        <div class="section-header">

            <div>

                <span class="section-label">
                    CURATED FOR YOU
                </span>

                <h2>
                    Ready-made baskets
                </h2>

            </div>

            <a href="#">
                Explore all →
            </a>

        </div>


        <div class="ready-grid">

            <div class="ready-card purple">

                <div>

                    <span>🎓</span>

                    <h3>
                        College Starter
                    </h3>

                    <p>
                        12 carefully selected essentials
                        for your first semester.
                    </p>

                    <strong>
                        Starting ₹2,999
                    </strong>

                    <button onclick="selectSituation('college')">
                        View Basket →
                    </button>

                </div>

            </div>


            <div class="ready-card orange">

                <div>

                    <span>✈️</span>

                    <h3>
                        Weekend Traveller
                    </h3>

                    <p>
                        Pack smarter for your next
                        short trip.
                    </p>

                    <strong>
                        Starting ₹2,499
                    </strong>

                    <button onclick="selectSituation('travel')">
                        View Basket →
                    </button>

                </div>

            </div>


            <div class="ready-card green">

                <div>

                    <span>💻</span>

                    <h3>
                        Study Setup
                    </h3>

                    <p>
                        Everything you need for
                        a focused workspace.
                    </p>

                    <strong>
                        Starting ₹1,999
                    </strong>

                    <button onclick="selectSituation('workspace')">
                        View Basket →
                    </button>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= NEWSLETTER ================= -->

    <section class="newsletter">

        <div>

            <span>SMART SHOPPING STARTS HERE</span>

            <h2>
                Your next basket is going
                to be a lot smarter.
            </h2>

        </div>

        <button onclick="scrollToSection('smartbasket')">
            Build a Basket →
        </button>

    </section>


    <!-- ================= FOOTER ================= -->

    <footer>

        <div class="footer-grid">

            <div class="footer-brand">

                <div class="logo">
                    Smart<span>Basket</span>
                </div>

                <p>
                    A smarter way to shop.
                    Choose your situation,
                    set your budget and build
                    a basket that actually makes sense.
                </p>

            </div>


            <div>

                <h4>Shop</h4>

                <a href="#products">Best Sellers</a>
                <a href="#deals">Today's Deals</a>
                <a href="#categories">Categories</a>
                <a href="#baskets">Smart Baskets</a>

            </div>


            <div>

                <h4>SmartBasket</h4>

                <a href="#smartbasket">How it works</a>
                <a href="#">About us</a>
                <a href="#">Careers</a>
                <a href="#">Contact</a>

            </div>


            <div>

                <h4>Help</h4>

                <a href="#">Your Account</a>
                <a href="#">Shipping</a>
                <a href="#">Returns</a>
                <a href="#">Help Center</a>

            </div>

        </div>


        <div class="footer-bottom">

            <span>
                © 2026 SmartBasket. All rights reserved.
            </span>

            <span>
                Made for smarter shopping 🛒
            </span>

        </div>

    </footer>


    <!-- ================= CART DRAWER ================= -->

    <div
        class="cart-overlay"
        id="cartOverlay"
        onclick="closeCart()">
    </div>


    <aside class="cart-drawer" id="cartDrawer">

        <div class="cart-header">

            <h2>
                Your Basket
            </h2>

            <button onclick="closeCart()">
                ✕
            </button>

        </div>

        <div id="cartItems">

            <div class="empty-cart">
                <span>🛒</span>

                <h3>
                    Your basket is empty
                </h3>

                <p>
                    Add something you like!
                </p>
            </div>

        </div>


        <div class="cart-footer">

            <div>
                <span>Total</span>

                <strong id="cartTotal">
                    ₹0
                </strong>
            </div>

            <button onclick="checkout()">
                Proceed to Checkout →
            </button>

        </div>

    </aside>


    <script src="script.js"></script>

</body>

</html>
